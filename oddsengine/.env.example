# =====================================================================
# SMARTBET ODDS ENGINE — environment template
# =====================================================================
# Copy to .env and fill in. NEVER commit a real .env.
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (bash)
#
# ---------------------------------------------------------------------
# DATABASE (required)
# ---------------------------------------------------------------------
# These are SERVER-SIDE credentials. The service-role key must never reach a
# browser, a client bundle or a log line — this process is the only consumer.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are taken from this file first.
# If they are missing here, the engine falls back to the website's .env (see
# ODDS_ENV_FALLBACK_FILES) so a local developer does not have to copy secrets
# into a second file. In a real deployment set both as environment variables
# and leave the fallback empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Extra files to look in for SUPABASE_* only, in order. Comma separated.
# Set to an empty string to disable the fallback entirely.
ODDS_ENV_FALLBACK_FILES=../.env

# ---------------------------------------------------------------------
# PROVIDER SELECTION
# ---------------------------------------------------------------------
# Comma-separated provider keys to run. Registered providers: mock, the-odds-api.
# Disable a provider by removing it from this list — nothing else needs to change
# and no quotes are deleted.
ENABLED_PROVIDERS=mock

# Which provider publishes the price the website shows and bets are settled at.
# Must be one of ENABLED_PROVIDERS. Only one source can be the pricing source;
# the database enforces it.
PRICING_PROVIDER=mock

# Which bookmaker inside that provider publishes the price.
# Empty = every bookmaker of that provider (only sane for single-book feeds such
# as the mock provider).
PRICING_BOOKMAKER=

# Development shortcut: force the mock provider even if a real provider is
# enabled, so tests and local runs never spend API credits.
ODDS_MOCK_MODE=false

# ---------------------------------------------------------------------
# POLLING
# ---------------------------------------------------------------------
# Live in-play polling. Target range is 2000–5000 ms; the engine refuses
# anything faster than 2000 ms. Polling faster than the provider refreshes does
# not make the data fresher, it only burns quota.
LIVE_POLL_INTERVAL_MS=3000

# Prematch polling. Target range is 30–60 minutes.
PREMETCH_POLL_INTERVAL_MS=1800000

# How far ahead each worker looks, in minutes.
LIVE_LOOKAHEAD_MINUTES=240
PREMETCH_LOOKAHEAD_MINUTES=10080

# Fixtures fetched per worker cycle (safety valve for very large books).
LIVE_MAX_FIXTURES=400
PREMETCH_MAX_FIXTURES=1200

# ---------------------------------------------------------------------
# PUSH DELIVERY (WebSocket / webhook)
# ---------------------------------------------------------------------
# A provider that offers a live stream can push updates instead of being polled.
# Providers without a stream are polled exactly as before, so leaving this on is
# harmless. Nothing here is required today: neither bundled provider streams.
PROVIDER_PUSH_ENABLED=false

# Pushed payloads are coalesced for this long, so a burst becomes one ingest
# rather than one database transaction per message.
PUSH_DEBOUNCE_MS=250

# A push-enabled worker still polls at this interval as a safety net, because
# streams drop and webhooks get lost. 0 disables the reconciliation poll.
PUSH_RECONCILE_INTERVAL_MS=60000

# ---------------------------------------------------------------------
# REQUEST HANDLING
# ---------------------------------------------------------------------
REQUEST_TIMEOUT_MS=8000
MAX_CONCURRENCY=8
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=15000

# Per-source client-side rate limit, requests per minute. 0 disables it.
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# How many quote rows are sent to the database per batch.
WRITE_BATCH_SIZE=500

# ---------------------------------------------------------------------
# CHANGE DETECTION / STALENESS
# ---------------------------------------------------------------------
# Only refresh odds_quotes.last_seen_at this often. 0 = only write when the
# price or status actually changed (recommended for live).
QUOTE_HEARTBEAT_SECONDS=15

# A quote older than this is reported as stale by `doctor` and the health table.
STALE_AFTER_SECONDS=180

# Refuse to publish a quote older than this. 0 disables the check.
PUBLISH_MAX_STALENESS_SECONDS=0

# ---------------------------------------------------------------------
# HISTORY
# ---------------------------------------------------------------------
# Master switch for writing provider-level price history. Per-market retention
# is configured in the database table odds_history_rules.
ODDS_HISTORY_ENABLED=true

# ---------------------------------------------------------------------
# MAPPING BEHAVIOUR
# ---------------------------------------------------------------------
# Unknown provider markets: record them in odds_market_rules for review and map
# them to a derived canonical code (true), or skip and queue them (false).
AUTO_MAP_UNKNOWN_MARKETS=true

# Create market_types rows for auto-mapped markets. Required if
# AUTO_MAP_UNKNOWN_MARKETS is true and the market has never been seen.
AUTO_CREATE_MARKET_TYPES=true

# Outright / futures events have no home and away team. Off by default.
INCLUDE_OUTRIGHTS=false

# Fixture matching: how far apart two kickoff times may be and still be
# considered the same fixture when the team names match.
FIXTURE_MATCH_WINDOW_HOURS=36

# ---------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
# pretty | json   (json for log collectors, pretty for a terminal)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------
# THE ODDS API  (provider key: the-odds-api)
# ---------------------------------------------------------------------
# Free key: https://the-odds-api.com/#get-access
THE_ODDS_API_KEY=

# Host and IPv6 alternative, per the official docs.
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
THE_ODDS_API_IPV6_BASE_URL=https://ipv6-api.the-odds-api.com
# true = use the IPv6 host (needed only on networks without IPv4).
THE_ODDS_API_USE_IPV6=false

# Send the key as the x-api-key header (private) instead of a query parameter.
THE_ODDS_API_USE_HEADER_AUTH=true

# Regions determine which bookmakers come back. us | us2 | uk | eu | au.
# Each region costs 1 quota credit per market requested.
THE_ODDS_API_REGIONS=uk

# Featured markets. Every market costs 1 credit per region, so keep this list
# tight while testing. Use the per-event endpoint for extended markets.
THE_ODDS_API_MARKETS=h2h,spreads,totals

# Sport keys to ingest. Empty = EVERY in-season sport, which is ~70 feeds and
# about 180 credits per cycle -- fine once, ruinous for a 3-second live poll.
# List keys explicitly instead; `node src/cli/main.ts sports --probe` shows which
# sports currently hold fixtures and prints a ready-to-paste list (free call).
THE_ODDS_API_SPORTS=soccer_epl

# Hard ceiling on credits one cycle may spend across its sport requests.
# 0 = no ceiling. This is what makes "ingest everything" survivable: a cycle
# takes as many sports as the budget allows, then stops and logs it.
THE_ODDS_API_MAX_CREDITS_PER_CYCLE=0

# Optional bookmaker allowlist (takes priority over regions).
# Cheaper: up to 10 bookmakers count as one region.
THE_ODDS_API_BOOKMAKERS=

# Pause the engine when the provider reports fewer credits than this.
THE_ODDS_API_MIN_QUOTA=25

# ---------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------
# Compute and report everything, write nothing.
DRY_RUN=false

# How long in-flight work is given to finish on SIGINT/SIGTERM.
SHUTDOWN_GRACE_MS=10000
